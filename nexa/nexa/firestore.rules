rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function isAdmin() { return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); }
    function notBanned() { return !exists(/databases/$(database)/documents/bans/$(request.auth.uid)); }
    function blockedBy(uid) { return exists(/databases/$(database)/documents/blocks/$(uid + '__' + request.auth.uid)); }
    // Changes to a list field only add or remove the caller.
    function onlySelfChange(field) {
      let before = resource.data.get(field, []);
      let after = request.resource.data.get(field, []);
      return after.removeAll(before).hasOnly([me()]) && before.removeAll(after).hasOnly([me()]);
    }

    // Public profiles: anyone signed in can read; only you can write yours.
    match /users/{uid} {
      // Anyone signed in can open a profile, but nobody can download the whole member list:
      // searches return at most 20 people, so friends are found by @handle or name.
      allow get: if signedIn();
      allow list: if signedIn() && request.query.limit <= 20;
      allow create, update, delete: if signedIn() && me() == uid;
      // Private prefs (nicknames, blocks, chat backgrounds, theme) — only you.
      match /private/{doc} {
        allow read, write: if signedIn() && me() == uid;
      }
    }

    // Unique @handles.
    match /handles/{handle} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == me();
      allow update, delete: if signedIn() && resource.data.uid == me();
    }

    // Blocks: "<blocker>__<blocked>". Used by the rules below.
    match /blocks/{id} {
      allow read: if signedIn() && resource.data.from == me();
      allow create: if signedIn() && request.resource.data.from == me() && id == me() + '__' + request.resource.data.to;
      allow delete: if signedIn() && resource.data.from == me();
    }

    // Moderators: add a document with your account ID to the "admins" collection in the Firebase console.
    match /admins/{uid} {
      allow read: if signedIn() && me() == uid;
    }
    match /bans/{uid} {
      allow read: if signedIn() && (me() == uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    // Reports: anyone can file one; only moderators can read or resolve them.
    match /reports/{id} {
      allow create: if signedIn() && request.resource.data.reporter == me();
      allow read, delete: if isAdmin();
    }

    // Voice/video calls: signalling between the two people on the call.
    match /calls/{cid} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && notBanned() && request.resource.data.from == me() && !blockedBy(request.resource.data.to);
      allow update: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      match /{side}/{doc} {
        function party() { let c = get(/databases/$(database)/documents/calls/$(cid)).data; return c.from == me() || c.to == me(); }
        allow read, create: if signedIn() && party();
      }
    }

    match /friendRequests/{id} {
      allow read: if signedIn() && (resource.data.from == me() || resource.data.to == me());
      allow create: if signedIn() && notBanned() && request.resource.data.from == me()
        && id == me() + '__' + request.resource.data.to
        && !blockedBy(request.resource.data.to);
      allow delete: if signedIn() && (resource.data.from == me() || resource.data.to == me());
    }

    match /friendships/{id} {
      allow read: if signedIn() && me() in resource.data.members;
      // Only the recipient of a pending request can create the friendship.
      allow create: if signedIn() && request.resource.data.members.size() == 2
        && ((request.resource.data.members[1] == me()
             && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.members[0] + '__' + me())))
         || (request.resource.data.members[0] == me()
             && exists(/databases/$(database)/documents/friendRequests/$(request.resource.data.members[1] + '__' + me()))));
      allow delete: if signedIn() && me() in resource.data.members;
    }

    match /conversations/{cid} {
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && notBanned() && me() in request.resource.data.members;
      allow update: if signedIn() && (me() in resource.data.members
        // joining an event chat: only adds yourself, and only if you're going to the event
        || (resource.data.type == 'event'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && onlySelfChange('members')
            && me() in get(/databases/$(database)/documents/events/$(resource.data.eventId)).data.attendees)
        // joining a group with an invite link: only adds yourself as a member
        || (resource.data.type == 'group'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'lastJoin'])
            && onlySelfChange('members')
            && request.resource.data.roles.get(me(), 'member') == 'member'
            && get(/databases/$(database)/documents/groupInvites/$(request.resource.data.lastJoin)).data.convId == cid)
        // joining a community channel: only adds yourself, and only if you're in the community
        || (resource.data.type == 'channel'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
            && onlySelfChange('members')
            && me() in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.members));
      // Shared drawing board strokes
      match /board/{sid} {
        function bconv() { return get(/databases/$(database)/documents/conversations/$(cid)).data; }
        allow read: if signedIn() && me() in bconv().members;
        allow create: if signedIn() && me() in bconv().members && request.resource.data.by == me();
        allow delete: if signedIn() && resource.data.by == me();
      }
      match /messages/{mid} {
        function conv() { return get(/databases/$(database)/documents/conversations/$(cid)).data; }
        function member() { return me() in conv().members; }
        function dmBlocked() { return conv().type == 'dm' && (blockedBy(conv().members[0]) || blockedBy(conv().members[1])); }
        allow read: if signedIn() && member();
        allow create: if signedIn() && notBanned() && member() && request.resource.data.from == me() && !dmBlocked();
        // Authors can edit/delete and attach link previews; members can react, vote and play; moderators can remove.
        allow update: if signedIn() && ((member() && (resource.data.from == me()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions', 'poll', 'game', 'transcript']))) || isAdmin());
        allow delete: if signedIn() && resource.data.from == me();
      }
    }

    match /events/{eid} {
      // Shared event album: anyone who can see the event can view; people going can add.
      match /photos/{pid} {
        function ev() { return get(/databases/$(database)/documents/events/$(eid)).data; }
        allow read: if signedIn() && (ev().public == true || me() in ev().viewers);
        allow create: if signedIn() && notBanned() && request.resource.data.by == me() && (me() in ev().attendees || ev().creator == me());
        allow delete: if signedIn() && (resource.data.by == me() || ev().creator == me());
      }
      allow read: if signedIn() && (resource.data.public == true || me() in resource.data.viewers);
      allow create: if signedIn() && notBanned() && request.resource.data.creator == me();
      allow delete: if signedIn() && resource.data.creator == me();
      allow update: if signedIn() && (resource.data.creator == me()
        // RSVP: viewers can add/remove only themselves
        || ((resource.data.public == true || me() in resource.data.viewers)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['attendees', 'maybe', 'declined', 'onway'])
            && onlySelfChange('attendees') && onlySelfChange('maybe') && onlySelfChange('declined') && onlySelfChange('onway'))
        // Joining with an invite link
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['viewers', 'attendees', 'lastInvite'])
            && onlySelfChange('viewers') && onlySelfChange('attendees')
            && get(/databases/$(database)/documents/eventInvites/$(request.resource.data.lastInvite)).data.eventId == eid));
    }

    // Communities with channels
    match /communities/{cid} {
      function role(u) { return resource.data.roles.get(u, 'member'); }
      allow read: if signedIn() && me() in resource.data.members;
      allow create: if signedIn() && notBanned() && request.resource.data.owner == me() && request.resource.data.members == [me()];
      allow delete: if signedIn() && resource.data.owner == me();
      allow update: if signedIn() && (
        // owner and admins manage channels and members; only the owner changes roles or ownership
        (me() in resource.data.members && role(me()) in ['owner', 'admin']
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles', 'channels', 'name', 'desc'])
          // admins can only remove people's roles (when removing them); the owner can change roles
          && (role(me()) == 'owner' || (request.resource.data.roles.diff(resource.data.roles).addedKeys().size() == 0
              && request.resource.data.roles.diff(resource.data.roles).changedKeys().size() == 0)))
        // joining with an invite link
        || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'lastJoin'])
            && onlySelfChange('members') && !(me() in resource.data.members)
            && get(/databases/$(database)/documents/communityInvites/$(request.resource.data.lastJoin)).data.communityId == cid)
        // leaving
        || (me() in resource.data.members && !(me() in request.resource.data.members)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'roles'])
            && onlySelfChange('members')));
    }
    match /communityInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me()
        && get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.roles.get(me(), 'member') in ['owner', 'admin'];
      allow delete: if signedIn() && resource.data.by == me();
    }

    // Drop-in voice rooms & group video calls (WebRTC signalling)
    match /rooms/{rid} {
      allow read: if signedIn() && (resource == null || me() in resource.data.audience);
      allow create: if signedIn() && notBanned() && me() in request.resource.data.audience;
      allow update: if signedIn() && me() in resource.data.audience
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['participants', 'audience']);
      match /sig/{sid} {
        allow read, delete: if signedIn() && (resource.data.to == me() || resource.data.from == me());
        allow create: if signedIn() && request.resource.data.from == me()
          && me() in get(/databases/$(database)/documents/rooms/$(rid)).data.audience;
      }
    }

    // Group invite links
    match /groupInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.by == me()
        && me() in get(/databases/$(database)/documents/conversations/$(request.resource.data.convId)).data.members;
      allow delete: if signedIn() && (resource.data.by == me()
        || me() in get(/databases/$(database)/documents/conversations/$(resource.data.convId)).data.members);
    }

    // Invite links: readable only by someone who knows the code (no listing).
    match /eventInvites/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && request.resource.data.host == me();
      allow delete: if signedIn() && resource.data.host == me();
    }

    // Moments: visible to the audience chosen when posting, for 24 hours.
    match /moments/{id} {
      allow read: if signedIn() && me() in resource.data.audience;
      allow create: if signedIn() && notBanned() && request.resource.data.author == me();
      allow delete: if signedIn() && resource.data.author == me();
      allow update: if signedIn() && me() in resource.data.audience
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['seen']) && onlySelfChange('seen');
    }

    match /notifications/{nid} {
      allow read, delete: if signedIn() && resource.data.to == me();
      allow create: if signedIn() && !blockedBy(request.resource.data.to)
        && (request.resource.data.from == me() || (request.resource.data.to == me() && request.resource.data.from == ''));
      allow update: if signedIn() && resource.data.to == me() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
    }
  }
}
